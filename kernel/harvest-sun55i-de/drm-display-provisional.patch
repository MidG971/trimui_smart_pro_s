+/*
+ * General MMIO read/write poke (STRICT_DEVMEM blocks /dev/mem; this doesn't).
+ *   echo "0xADDR"        > poke_wr   -> read  u32 at ADDR
+ *   echo "0xADDR 0xVAL"  > poke_wr   -> write u32 VAL then read back
+ * Lets us inspect/poke the tcon-top (0x5500000) + any reg at runtime.
+ */
+static int poke_wr_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int addr = 0, data = 0, rb = 0;
+	void __iomem *p;
+	int n;
+
+	n = sscanf(val, "%x %x", &addr, &data);
+	if (n < 1)
+		return -EINVAL;
+	p = ioremap(addr & ~0x3U, 4);
+	if (!p)
+		return -ENOMEM;
+	if (n >= 2)
+		writel(data, p);
+	rb = readl(p);
+	iounmap(p);
+	pr_info("POKE-MMIO: [0x%08x] %s 0x%08x\n",
+		addr, (n >= 2) ? "wrote->rb" : "read", rb);
