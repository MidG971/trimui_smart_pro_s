+/*
+ * Runtime poke (STEP 0): experiment with the CPU-interface trigger without a
+ * cold-boot per attempt. echo N > /sys/module/sun4i_tcon/parameters/tcon_poke
+ *   1 = pulse trigger_start(BIT1) once   2 = pulse 8x   3 = set auto_(BIT17)
+ *   4 = set trigger_en+fifo_en+flush     0 = just dump
+ * Every command dumps TCON CPU_IF/CTL/debug(0xfc) + DSI line/inst/fifo (ioremap).
+ */
+static struct sun4i_tcon *poke_tcon;
+
+static int tcon_poke_set(const char *val, const struct kernel_param *kp)
+{
+	struct sun4i_tcon *t = poke_tcon;
+	void __iomem *dsi;
+	u32 cpuif = 0, ctl = 0, dbg = 0, dline = 0, dfifo = 0, dinst = 0;
+	int cmd, i, ret;
+
+	ret = kstrtoint(val, 0, &cmd);
+	if (ret)
+		return ret;
+	if (!t) {
+		pr_info("TCON-POKE: no tcon bound yet\n");
+		return 0;
+	}
+
+	if (cmd == 1 || cmd == 2) {
+		for (i = 0; i < (cmd == 2 ? 8 : 1); i++) {
+			regmap_update_bits(t->regs, SUN4I_TCON0_CPU_IF_REG,
+					   BIT(1), BIT(1));
+			udelay(200);
+		}
+	} else if (cmd == 3) {
+		regmap_update_bits(t->regs, SUN4I_TCON0_CPU_IF_REG,
+				   BIT(17), BIT(17));
+	} else if (cmd == 4) {
+		regmap_update_bits(t->regs, SUN4I_TCON0_CPU_IF_REG,
+				   BIT(16) | BIT(2) | BIT(0),
+				   BIT(16) | BIT(2) | BIT(0));
+	}
+
+	regmap_read(t->regs, SUN4I_TCON0_CPU_IF_REG, &cpuif);
+	regmap_read(t->regs, SUN4I_TCON0_CTL_REG, &ctl);
+	regmap_read(t->regs, 0xfc, &dbg);
+
+	dsi = ioremap(0x5508000, 0x400);
+	if (dsi) {
+		dline = readl(dsi + 0x2e0) & 0x1fff;
+		dinst = readl(dsi + 0x2f0);
+		dfifo = (readl(dsi + 0x2f4) >> 16) & 0xffff;
+		iounmap(dsi);
+	}
+
+	pr_info("TCON-POKE cmd=%d: CPU_IF=0x%08x CTL=0x%08x dbg0xfc=0x%08x(line0=%u) | dsi_line=%u inst=0x%08x fifo=%u\n",
+		cmd, cpuif, ctl, dbg, (dbg >> 16) & 0xfff, dline, dinst, dfifo);
+	return 0;
+}
