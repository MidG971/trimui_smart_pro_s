+	0x00, 0x9d, 0x15, 0x00, 0x02, 0xc5, 0x25, 0x15, 0x00, 0x02, 0x00, 0x00,
+	0x15, 0x00, 0x02, 0xd0, 0x56, 0x05, 0x78, 0x01, 0x11, 0x05, 0x14, 0x01,
+	0x29, 0x05, 0x14, 0x01, 0x35,
+};
+
+static const u8 trimui_exit_seq[] = {
+	0x05, 0x00, 0x01, 0x28, 0x05, 0x78, 0x01, 0x10,
+};
+
+static const struct drm_display_mode trimui_mode = {
+	.clock		= 62000,
+	.hdisplay	= 720,
+	.hsync_start	= 720 + 32,
+	.hsync_end	= 720 + 32 + 4,
+	.htotal		= 720 + 32 + 4 + 88,	/* 844, matches the stock TCON */
+	.vdisplay	= 1280,
+	.vsync_start	= 1280 + 16,
+	.vsync_end	= 1280 + 16 + 4,
+	.vtotal		= 1280 + 16 + 4 + 9,	/* 1309, matches the stock TCON */
+	.width_mm	= 62,	/* ~5" portrait panel; VERIFY exact dimensions */
+	.height_mm	= 110,
+	.type		= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static inline struct trimui_panel *to_trimui_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct trimui_panel, panel);
+}
+
+/* Replay an Allwinner-packed DCS sequence: <type> <wait_ms> <len> <payload...> */
+static void trimui_panel_replay(struct mipi_dsi_multi_context *ctx,
+				const u8 *seq, size_t size)
+{
+	size_t i = 0;
+
+	while (i + 3 <= size) {
+		u8 wait = seq[i + 1];	/* seq[i] = DCS type, implied by length */
+		u8 len = seq[i + 2];
+
+		i += 3;
+		if (i + len > size)
+			break;
+		mipi_dsi_dcs_write_buffer_multi(ctx, &seq[i], len);
+		if (wait)
+			mipi_dsi_msleep(ctx, wait);
+		i += len;
+	}
+}
+
+static int trimui_panel_prepare(struct drm_panel *panel)
+{
+	struct trimui_panel *p = to_trimui_panel(panel);
+	struct mipi_dsi_multi_context ctx = { .dsi = p->dsi };
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(p->supplies), p->supplies);
+	if (ret)
+		return ret;
+
+	/* Reset pulse, then the vendor's 120 ms settle before commands. */
+	gpiod_set_value_cansleep(p->reset, 1);
+	msleep(20);
+	gpiod_set_value_cansleep(p->reset, 0);
+	msleep(120);
+
+	trimui_panel_replay(&ctx, trimui_init_seq, ARRAY_SIZE(trimui_init_seq));
+	if (ctx.accum_err) {
+		gpiod_set_value_cansleep(p->reset, 1);
+		regulator_bulk_disable(ARRAY_SIZE(p->supplies), p->supplies);
+	}
+
+	return ctx.accum_err;
+}
+
+static int trimui_panel_unprepare(struct drm_panel *panel)
+{
+	struct trimui_panel *p = to_trimui_panel(panel);
+	struct mipi_dsi_multi_context ctx = { .dsi = p->dsi };
+
+	trimui_panel_replay(&ctx, trimui_exit_seq, ARRAY_SIZE(trimui_exit_seq));
+	gpiod_set_value_cansleep(p->reset, 1);
+	regulator_bulk_disable(ARRAY_SIZE(p->supplies), p->supplies);
+
+	return 0;
+}
+
+static int trimui_panel_get_modes(struct drm_panel *panel,
+				  struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &trimui_mode);
+}
+
+static const struct drm_panel_funcs trimui_panel_funcs = {
+	.prepare	= trimui_panel_prepare,
+	.unprepare	= trimui_panel_unprepare,
+	.get_modes	= trimui_panel_get_modes,
+};
+
+static int trimui_panel_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct trimui_panel *p;
+	int ret;
+
+	p = devm_drm_panel_alloc(dev, struct trimui_panel, panel,
+				 &trimui_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(p))
+		return PTR_ERR(p);
+
+	p->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, p);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/*
+	 * Experiment (LP-11 duty hypothesis, 2026-10-02): dropped
+	 * MIPI_DSI_MODE_VIDEO_BURST. The panel is driven via the TCON 8080
+	 * CPU-interface, so the DSI controller's burst/DRQ path is incoherent
+	 * here; removing it is step 1 toward letting the link idle between the
+	 * per-frame CPU-IF transfers (reducing the continuous HS-clock duty that
+	 * appears to cook the DDIC).
+	 */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_LPM;
+
+	p->supplies[0].supply = "power0";
+	p->supplies[1].supply = "power1";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(p->supplies), p->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+
+	p->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(p->reset))
+		return dev_err_probe(dev, PTR_ERR(p->reset),
+				     "failed to get reset gpio\n");
+
+	ret = drm_panel_of_backlight(&p->panel);
+	if (ret)
+		return ret;
+
+	drm_panel_add(&p->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&p->panel);
+		return dev_err_probe(dev, ret, "failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void trimui_panel_remove(struct mipi_dsi_device *dsi)
+{
+	struct trimui_panel *p = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&p->panel);
+}
+
+static const struct of_device_id trimui_panel_of_match[] = {
+	{ .compatible = "trimui,smart-pro-s-panel" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, trimui_panel_of_match);
+
+static struct mipi_dsi_driver trimui_panel_driver = {
+	.probe	= trimui_panel_probe,
+	.remove	= trimui_panel_remove,
+	.driver	= {
+		.name		= "panel-trimui-smart-pro-s",
+		.of_match_table	= trimui_panel_of_match,
+	},
+};
+module_mipi_dsi_driver(trimui_panel_driver);
+
+MODULE_AUTHOR("Midgy BALON");
+MODULE_DESCRIPTION("Trimui Smart Pro S MIPI-DSI panel");
+MODULE_LICENSE("GPL");
