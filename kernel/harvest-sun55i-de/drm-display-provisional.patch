+/* Captured diagnostic, not a general CPU timing algorithm. */
+static int sun4i_tcon0_mode_set_a523_trigger(struct sun4i_tcon *tcon,
+					 const struct drm_encoder *encoder,
+					 const struct drm_display_mode *mode)
+{
+	struct sun6i_dsi *dsi = encoder_to_sun6i_dsi(encoder);
+	struct mipi_dsi_device *device = dsi->device;
+	const struct {
+		u32 reg, mask, value;
+	} config[] = {
+		{ SUN4I_TCON0_DCLK_REG, GENMASK(31, 28) | GENMASK(6, 0), (0xfU << 28) | 1 },
+		{ SUN4I_TCON0_CTL_REG,
+		  SUN4I_TCON0_CTL_IF_MASK | SUN4I_TCON0_CTL_CLK_DELAY_MASK,
+		  SUN4I_TCON0_CTL_IF_8080 | SUN4I_TCON0_CTL_CLK_DELAY(2) },
+		{ 0x03c, ~0U, 0 }, /* stock 3D FIFO setting */
+		{ SUN4I_TCON_ECC_FIFO_REG, SUN4I_TCON_ECC_FIFO_EN, 0 },
+		/* BSP writes raw block_space=844-720-40=84 (not space-1). */
+		{ SUN4I_TCON0_CPU_TRI0_REG, ~0U, (84U << 16) | (720 - 1) },
+		/* Upper half is a live block counter, not configuration. */
+		{ SUN4I_TCON0_CPU_TRI1_REG, GENMASK(15, 0), 1280 - 1 },
+		/* 315 is an observed stock value, only valid for this diagnostic. */
+		{ SUN4I_TCON0_CPU_TRI2_REG, ~0U,
+		  SUN4I_TCON0_CPU_TRI2_START_DELAY(315) |
+		  SUN4I_TCON0_CPU_TRI2_TRANS_START_SET(10) },
+		/* No AUTO and no software trigger_start pulse. */
+		{ SUN4I_TCON0_CPU_IF_REG, ~0U,
+		  SUN4I_TCON0_CPU_IF_MODE_DSI | SUN4I_TCON0_CPU_IF_TRI_FIFO_FLUSH |
+		  SUN4I_TCON0_CPU_IF_TRI_FIFO_EN | SUN4I_TCON0_CPU_IF_TRI_EN },
+	};
+	u32 value;
+	unsigned int i;
+	int ret;
+
+	if (tcon->pixel_enabled)
+		return -EBUSY;
+	tcon->pixel_clock_valid = false;
+	tcon->pixel_cpu_trigger = false;
+	if (!tcon->pixel_clk ||
+	    !of_device_is_compatible(tcon->dev->of_node,
+				     "allwinner,sun55i-a523-tcon-lcd") ||
+	    !of_device_is_compatible(device->dev.of_node, "trimui,smart-pro-s-panel") ||
+	    device->lanes != 4 || device->format != MIPI_DSI_FMT_RGB888 ||
+	    device->mode_flags != (MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_LPM) ||
+	    mode->crtc_hdisplay != 720 || mode->crtc_vdisplay != 1280 ||
+	    /*
+	     * Only the active area is pinned (block_size 720, block_num 1280);
+	     * clock and porches are not - the panel runs 62 MHz / 844 / 1309.
+	     */
+	    (mode->flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN)))
+		return -EINVAL;
+
+	/* Keep the native timing and checked 62 MHz /1 clock negotiation. */
+	sun4i_tcon0_mode_set_dsi_video(tcon, encoder, mode);
+	if (!tcon->pixel_clock_valid)
+		return -EIO;
+	tcon->pixel_clock_valid = false;
+	for (i = 0; i < ARRAY_SIZE(config); i++) {
+		ret = regmap_update_bits(tcon->regs, config[i].reg,
+					 config[i].mask, config[i].value);
+		if (ret)
+			return ret;
+		ret = regmap_read(tcon->regs, config[i].reg, &value);
+		if (ret)
+			return ret;
+		if ((value & config[i].mask) != config[i].value)
+			return -EIO;
+	}
+	/* CCF enables/disables all four DCLK gates, only after PLL prepare. */
+	tcon->pixel_cpu_trigger = true;
+	tcon->retrig_dsi = dsi;
+	tcon->pixel_clock_valid = true;
+	dev_info(tcon->dev, "A523 stock-trigger diagnostic: pixel=62000000 /1, block_space=84 start_delay=315, AUTO=0\n");
+	return 0;
+}
