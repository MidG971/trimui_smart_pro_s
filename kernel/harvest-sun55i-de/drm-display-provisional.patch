+static void sun4i_tcon0_mode_set_dsi_video(struct sun4i_tcon *tcon,
+					   const struct drm_encoder *encoder,
+					   const struct drm_display_mode *mode)
+{
+	unsigned int bp, hsync, vsync;
+	u8 clk_delay;
+	u32 val = 0;
+	int ret;
+
+	/* Do not change the CCF gate policy while the pixel clock is active. */
+	if (tcon->pixel_clk && tcon->pixel_enabled) {
+		dev_err(tcon->dev, "Refusing active DISPLL modeset\n");
+		return;
+	}
+	tcon->pixel_cpu_trigger = false;
+
+	/*
+	 * sun55i-a523-class DSI in video/burst mode drives the TCON like an
+	 * RGB panel: continuous scanout with a free-running vblank, rather
+	 * than the 8080 CPU-interface per-frame trigger. This is our current
+	 * diagnostic video path, not proof that stock uses HV mode. With a
+	 * DISPLL LS parent, the pixel clock is HS / 6 and DCLK must divide by 1.
+	 */
+	tcon->dclk_min_div = tcon->quirks->dclk_min_div;
+	tcon->dclk_max_div = 127;
+	tcon->pixel_clock_valid = false;
+	ret = clk_set_rate(tcon->dclk, mode->crtc_clock * 1000);
+	if (tcon->pixel_clk &&
+	    (ret || clk_get_rate(tcon->dclk) != mode->crtc_clock * 1000UL)) {
+		dev_err(tcon->dev, "DISPLL pixel rate rejected: %d kHz, error %d\n",
+			mode->crtc_clock, ret);
+		return;
+	}
+	tcon->pixel_clock_valid = true;
+
+	/* Set the resolution */
+	regmap_write(tcon->regs, SUN4I_TCON0_BASIC0_REG,
+		     SUN4I_TCON0_BASIC0_X(mode->crtc_hdisplay) |
+		     SUN4I_TCON0_BASIC0_Y(mode->crtc_vdisplay));
+
+	sun4i_tcon0_mode_set_dithering(tcon, sun4i_tcon_get_connector(encoder));
+
+	/* HV (RGB-style) interface + clock delay */
+	clk_delay = sun4i_tcon_get_clk_delay(mode, 0);
+	regmap_update_bits(tcon->regs, SUN4I_TCON0_CTL_REG,
+			   SUN4I_TCON0_CTL_IF_MASK |
+			   SUN4I_TCON0_CTL_CLK_DELAY_MASK,
+			   SUN4I_TCON0_CTL_CLK_DELAY(clk_delay));
+
+	/*
+	 * Put the TCON output FIFO to the DSI in normal-fifo mode
+	 * (tcon0_3d_fifo @ 0x38, fifo_3d_setting = 1).  Mainline never
+	 * programs this; at reset the FIFO delivers the DSI a single line
+	 * and then stalls.
+	 */
+	regmap_write(tcon->regs, 0x03c, 0x1);
+
+	/* Horizontal timings (backporch here means back porch + hsync) */
+	bp = mode->crtc_htotal - mode->crtc_hsync_start;
+	regmap_write(tcon->regs, SUN4I_TCON0_BASIC1_REG,
+		     SUN4I_TCON0_BASIC1_H_TOTAL(mode->crtc_htotal) |
+		     SUN4I_TCON0_BASIC1_H_BACKPORCH(bp));
+
+	/* Vertical timings */
+	bp = mode->crtc_vtotal - mode->crtc_vsync_start;
+	regmap_write(tcon->regs, SUN4I_TCON0_BASIC2_REG,
+		     SUN4I_TCON0_BASIC2_V_TOTAL(mode->crtc_vtotal * 2) |
+		     SUN4I_TCON0_BASIC2_V_BACKPORCH(bp));
+
+	hsync = mode->crtc_hsync_end - mode->crtc_hsync_start;
+	vsync = mode->crtc_vsync_end - mode->crtc_vsync_start;
+	regmap_write(tcon->regs, SUN4I_TCON0_BASIC3_REG,
+		     SUN4I_TCON0_BASIC3_V_SYNC(vsync) |
+		     SUN4I_TCON0_BASIC3_H_SYNC(hsync));
+
+	/* Signal polarity */
+	if (mode->flags & DRM_MODE_FLAG_PHSYNC)
+		val |= SUN4I_TCON0_IO_POL_HSYNC_POSITIVE;
+	if (mode->flags & DRM_MODE_FLAG_PVSYNC)
+		val |= SUN4I_TCON0_IO_POL_VSYNC_POSITIVE;
+	regmap_update_bits(tcon->regs, SUN4I_TCON0_IO_POL_REG,
+			   SUN4I_TCON0_IO_POL_HSYNC_POSITIVE |
+			   SUN4I_TCON0_IO_POL_VSYNC_POSITIVE, val);
+
+	/* Map output to channel 0 */
+	regmap_update_bits(tcon->regs, SUN4I_TCON_GCTL_REG,
+			   SUN4I_TCON_GCTL_IOMAP_MASK,
+			   SUN4I_TCON_GCTL_IOMAP_TCON0);
+
+	/* Tristate the unused RGB output pins (pixels go to the DSI) */
+	regmap_write(tcon->regs, SUN4I_TCON0_IO_TRI_REG, 0xe0000000);
+}
