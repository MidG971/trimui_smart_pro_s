/*
 * Trimui Smart Pro S handheld (board "A523-PRO2-AXP717C").
 * SoC: Allwinner A523 (sun55iw3p1). Base: mainline sun55i-a523.dtsi.
 *
 * WORK IN PROGRESS. Modeled on the upstream sun55i-t527-avaota-a1.dts (same SoC
 * family). Built with the display series in kernel/patches/ applied and
 * trimui-panel.dtsi appended (see kernel/build-trimui-kernel.sh).
 *
 * On board now: PMIC (axp717 @0x34 + axp1530 @0x36) + regulators, storage
 * (microSD/eMMC), USB2, RTC, LEDC RGB array, GPU (Mali-G57 / Panfrost, upstream),
 * MIPI-DSI panel + PWM backlight (via patches), fan + vibrator (PWM), audio codec,
 * LRADC side keys, WiFi/BT power sequencing (AIC8800D80, out-of-tree module), and
 * the gamepad UARTs (uart5/uart7 MCUs — the whole pad incl. sticks, read by the
 * trimui_inputd daemon; NOT GPADC, confirmed on HW). Still pending: USB3 (draft in
 * dts/staging/). See PORTING-NOTES.md and docs/ON-DEVICE-FINDINGS.md.
 *
 * "VERIFY" = needs confirmation by i2c/dump on real hardware before trusting.
 * Rail->consumer map is derived from the vendor DTB where known and otherwise
 * mirrors Avaota A1; the exact Trimui map must be read from the device.
 */

/dts-v1/;

#include "sun55i-a523.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pwm/pwm.h>

/ {
	model = "Trimui Smart Pro S";
	/* T527 is the same die as A523; A523 is what mainline carries. */
	compatible = "trimui,smart-pro-s", "allwinner,sun55i-a523";

	aliases {
		serial0 = &uart0;
		mmc0 = &mmc0;	/* microSD */
		mmc1 = &mmc1;	/* WiFi SDIO */
		mmc2 = &mmc2;	/* eMMC */
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/*
	 * Fn switch — a 2-position slide switch on PL11 (the vendor's "dip-switch",
	 * gpio363; trimui_inputd reads it). Drives both levels cleanly: reads 1 in
	 * one position, 0 in the other (HW-verified 2026-09-25 via MMIO). Reported
	 * as KEY_FN, asserted in the low position. (Home/Vol± are LRADC side-keys;
	 * power is the AXP717 PEK — neither is here.)
	 */
	gpio-keys {
		compatible = "gpio-keys";

		fn-switch {
			label = "Fn Switch";
			linux,code = <KEY_FN>;
			gpios = <&r_pio 0 11 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * LiPo pack, 5000 mAh. Values from the vendor DTB: battery-cap 0x1388 =
	 * 5000 mAh, init-chgvol 0x1068 = 4.2 V CV, runtime-chgcur 0x3e8 = 1 A
	 * (the vendor bumps to ~1.95 A in suspend/shutdown). The AXP717 has a
	 * hardware fuel gauge (E-gauge) that reports charge % directly, so mainline's
	 * axp717 battery driver reads SoC from hardware and consumes only the
	 * charge-current + voltage limits below — the vendor's 32-point OCV curve
	 * (pmu_bat_para1..32) is not needed by mainline (kept in FIRMWARE-FINDINGS).
	 * VERIFY the design-min and capacity against the device.
	 */
	battery: battery {
		compatible = "simple-battery";
		voltage-min-design-microvolt = <3400000>;		/* VERIFY */
		voltage-max-design-microvolt = <4200000>;		/* vendor CV = 4.2 V */
		constant-charge-current-max-microamp = <1000000>;	/* 1 A runtime */
		charge-full-design-microamp-hours = <5000000>;		/* 5000 mAh */
	};

	/*
	 * Active cooling fan on PWM0 channel 10 / PB6 (vendor: 40 us period,
	 * inverted, 32 levels). #cooling-cells lets a thermal zone bind it once
	 * the A523 THS series lands; usable as a manual cooling device until then.
	 * &pwm0 is enabled via trimui-panel.dtsi.
	 */
	pwm_fan: pwm-fan {
		compatible = "pwm-fan";
		pwms = <&pwm0 10 40000 PWM_POLARITY_INVERTED>;
		#cooling-cells = <2>;
		cooling-levels = <0 1 20 30 40 50 60 70 80 90 100 110 120
				  130 140 150 160 170 180 190 200 205 210
				  215 220 225 230 235 240 245 250 255>;
	};

	/* ★ Side-board / peripheral +5V master enable = PK15 (vendor runtrimui.sh
	 * "#5V enable", gpio335). This load-switch feeds the +5V rail shared by the
	 * two gamepad MCUs, the WS2812 LED array AND the fan. Without it all three are
	 * dead (LED ring dark, fan still, MCUs' 3.3V floats to ~1.6V = unpowered).
	 * Driving PK15 high via a fixed-reg (libgpiod EINVALs on &pio) brings all
	 * three alive. HW-verified: LEDs light, fan spins, MCUs stream at 9600 baud. */
	reg_5v_en: regulator-5v-en {
		compatible = "regulator-fixed";
		regulator-name = "sideboard-5v-en";
		gpio = <&pio 10 15 GPIO_ACTIVE_HIGH>;	/* PK15 */
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	/* Speaker power-amp enable = PH6 (active high). The codec card has no
	 * pa-gpios, so drive it always-on here to route Line Out -> the speaker. */
	reg_spk_amp: regulator-spk-amp {
		compatible = "regulator-fixed";
		regulator-name = "spk-amp-en";
		gpio = <&pio 7 6 GPIO_ACTIVE_HIGH>;	/* PH6 */
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	/* Gamepad MCU + LED-array power enables (vendor trimui_inputd drives these
	 * GPIOs high: PK12 = left pad, PK16 = right pad, PK18 = LED array). gpio-hogs
	 * are mis-parsed by this A523 pinctrl, so drive them via always-on fixed regs. */
	reg_pad_left: regulator-pad-left {
		compatible = "regulator-fixed";
		regulator-name = "leftpad-en";
		gpio = <&pio 10 12 GPIO_ACTIVE_HIGH>;	/* PK12 */
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_pad_right: regulator-pad-right {
		compatible = "regulator-fixed";
		regulator-name = "rightpad-en";
		gpio = <&pio 10 16 GPIO_ACTIVE_HIGH>;	/* PK16 */
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_led_array: regulator-led-array {
		compatible = "regulator-fixed";
		regulator-name = "ledarray-en";
		gpio = <&pio 10 18 GPIO_ACTIVE_HIGH>;	/* PK18 */
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	/* Vendor drives PH12 ("rumble motor") low at boot, high while rumbling.
	 * Model it as the motor's vcc-supply so the driver powers the motor only
	 * during playback (regulator_enable on start / disable on stop). The
	 * supply is consumed by the gamepad LEFT node (vcc-supply), which owns
	 * the rumble motor and exposes it as FF_RUMBLE on the pad.
	 * HW-verified: motor buzzes with PH12 as vcc + PWM0 ch7 (PK23). */
	reg_vibra_pwr: regulator-vibra-pwr {
		compatible = "regulator-fixed";
		regulator-name = "vibra-pwr";
		gpio = <&pio 7 12 GPIO_ACTIVE_HIGH>;	/* PH12 */
		enable-active-high;
	};

	/*
	 * VBUS switch for the "USB host" USB-C port (the plain host port, not the
	 * OTG/DP one). Drives the port's 5V; gated by the USB PHY for host port 1
	 * (ehci1/ohci1 = phys=<&usbphy 1>). HW-verified: a USB2 hub + keyboard
	 * enumerate on ehci1. The vendor keeps this rail always-on; here the phy
	 * enables it when the host port powers up.
	 */
	reg_usb1_vbus: regulator-usb1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb1-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-enable-ramp-delay = <1000>;
		gpio = <&pio 4 6 GPIO_ACTIVE_HIGH>;	/* PE6 */
		enable-active-high;
	};

	/*
	 * AIC8800 WiFi power/reset sequencing for the mmc1 SDIO bus. The vendor
	 * sunxi-rfkill node drives THREE enables to bring the chip out of reset;
	 * driving only wlan_regon leaves it silent to CMD5 (HW-verified). All on
	 * R_PIO, ACTIVE_LOW so deassert (high) = enabled -> an off->on power cycle:
	 * power_en = PL7 (bank 0 pin 7), chip_en = PM5 (bank 1 pin 5), wlan_regon =
	 * PM1 (bank 1 pin 1). Chip needs the out-of-tree aic8800 module.
	 */
	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&r_pio 0 7 GPIO_ACTIVE_LOW>,	/* PL7 power_en */
			      <&r_pio 1 5 GPIO_ACTIVE_LOW>,	/* PM5 chip_en */
			      <&r_pio 1 1 GPIO_ACTIVE_LOW>;	/* PM1 wlan_regon */
		post-power-on-delay-ms = <200>;
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pb_pins>;
	status = "okay";
};

/*
 * UART1 (PG6-PG9, with RTS/CTS) = AIC8800 Bluetooth HCI. The BT side needs the
 * out-of-tree aic8800 module; control lines are on R_PIO Port M: bt_rst_n = PM2,
 * bt_wake = PM3, bt_hostwake = PM4.
 */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>, <&uart1_rts_cts_pins>;
	uart-has-rtscts;
	status = "okay";
};

/*
 * Gamepad MCU serial links (RX-only, single wire each): uart5 = PK17 (LEFT half),
 * uart7 = PK13 (RIGHT half). Two 19200-baud MCUs stream the whole pad
 * (D-pad/ABXY/L-R/L2-R2/sticks/L3-R3/rumble); each fills its own half of the
 * frame. The gamepad-trimui-smart-pro-s serdev driver binds both child nodes and
 * merges them into one virtual Xbox 360 pad (045e:028e "TRIMUI Player1"), as the
 * vendor trimui_inputd daemon did. Once the driver binds, /dev/ttyASx for these
 * ports disappear (they become serdev buses) — that is expected.
 * Verified on HW 2026-08-18: MCUs stream after the PK15 side-board +5V enable.
 */
&uart5 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart5_pk17_pin>;
	status = "okay";

	gamepad_left: gamepad {
		compatible = "trimui,smart-pro-s-gamepad-left";
		current-speed = <19200>;

		/*
		 * The rumble motor belongs to the pad: the gamepad driver
		 * exposes FF_RUMBLE on the merged input device and drives this
		 * PWM (+ GPIO-gated supply) directly. Modelled on the vendor
		 * pwm-vibrator (PWM0 ch7, 50 us period; PH12 gates the motor
		 * supply). The LEFT node owns it; there is one motor.
		 */
		pwms = <&pwm0 7 50000 0>;
		vcc-supply = <&reg_vibra_pwr>;
	};
};

&uart7 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart7_pk13_pin>;
	status = "okay";

	gamepad_right: gamepad {
		compatible = "trimui,smart-pro-s-gamepad-right";
		current-speed = <19200>;
	};
};

/*
 * Reduced-I2C bus: main PMIC lives here (vendor "pmu@34" on s_twi0 = r_i2c0).
 * CONFIRMED ON HARDWARE 2026-07-22: kernel probes "AXP20x variant AXP2202" @0x34;
 * silk = AXP717C; vendor driver = axp2202 — all the same PMIC. Mainline drives it
 * as `x-powers,axp717` (every upstream sun55i board — cubie-a5e / avaota-a1 /
 * orangepi-4a — uses axp717), so that is correct here too.
 */
&r_i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&r_i2c_pins>;
	status = "okay";

	axp717: pmic@34 {
		compatible = "x-powers,axp717";	/* = the AXP2202/AXP717C on this board (confirmed) */
		reg = <0x34>;
		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-parent = <&nmi_intc>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;

		axp717_adc: adc {
			compatible = "x-powers,axp717-adc";
			#io-channel-cells = <1>;
		};

		battery-power {
			compatible = "x-powers,axp717-battery-power-supply";
			monitored-battery = <&battery>;
		};

		usb-power {
			compatible = "x-powers,axp717-usb-power-supply";
		};

		regulators {
			/* dcdc1: CPU "little" cluster (vendor cpu-supply = dcdc1). */
			reg_dcdc1: dcdc1 {
				regulator-always-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <1160000>;
				regulator-name = "vdd-cpu";
			};

			reg_dcdc2: dcdc2 {
				regulator-always-on;
				regulator-min-microvolt = <920000>;
				regulator-max-microvolt = <920000>;
				regulator-name = "vdd-gpu-sys";	/* VERIFY */
			};

			/*
			 * LPDDR4 VCC-DRAM. Datasheet Table 6-2 (Recommended
			 * Operating Conditions): 1.06 / 1.10 / 1.17 V. Use 1.10 V
			 * typ — earlier 1.16 V was wrong (copied from the CPU rail,
			 * no margin). Confirm via AXP2202 DCDC3 i2c read on HW.
			 * See uboot/DRAM-VALIDATION.md.
			 */
			reg_dcdc3: dcdc3 {
				regulator-always-on;
				regulator-min-microvolt = <1100000>;
				regulator-max-microvolt = <1100000>;
				regulator-name = "vdd-dram";
			};

			reg_dcdc4: dcdc4 {
				/*
				 * Live capture 2026-07-26: DCDC4 = 1.0 V and
				 * DISABLED on the vendor kernel. The earlier
				 * "vdd-io 3.3 V always-on" was a wrong guess — it is
				 * an unused rail here. Leave unconfigured (off).
				 */
			};

			reg_aldo1: aldo1 {
				/* VERIFY connection */
			};

			reg_aldo2: aldo2 {
				/* VERIFY connection */
			};

			/* aldo3: WiFi 3.3V (vendor wlan_power[0] = aldo3 @ 3.3V). */
			reg_aldo3: aldo3 {
				regulator-always-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc-wifi-3v3";	/* VERIFY */
			};

			reg_aldo4: aldo4 {
				regulator-always-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc-pll-avcc";	/* VERIFY */
			};

			/* bldo1: WiFi 1.8V (vendor wlan_power[1] = bldo1 @ 1.8V). */
			reg_bldo1: bldo1 {
				regulator-always-on;	/* AIC8800 core/RF 1.8V rail (kept powered) */
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc-wifi-1v8";	/* VERIFY */
			};

			/* bldo2: 1.8V, vendor keeps on (wlan_power[2]). */
			reg_bldo2: bldo2 {
				regulator-always-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc-1v8";	/* VERIFY */
			};

			reg_bldo3: bldo3 {
				/* VERIFY connection */
			};

			reg_bldo4: bldo4 {
				/* VERIFY connection */
			};

			reg_cldo1: cldo1 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc-1v8-io";	/* VERIFY (mmc vqmmc) */
			};

			reg_cldo2: cldo2 {
				/* VERIFY connection */
			};

			reg_cldo3: cldo3 {
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc-3v3-io-mmc";	/* VERIFY (mmc vmmc) */
			};

			reg_cldo4: cldo4 {
				/* panel power0: vendor live dump = 3.3V (05-regulators.txt,
				 * ON-DEVICE-FINDINGS). Was UNCONSTRAINED -> panel power0 at an
				 * undefined voltage (thermal-suspect for the hot display IC). */
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "panel-power0-3v3";
			};

			reg_cpusldo: cpusldo {
				regulator-always-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-name = "vdd-cpus";
			};

			/* AXP2202 5V boost. Kept on for the board 5V rail (USB-host
			 * VBUS); note HW testing showed it is NOT what powers the fan
			 * / gamepad MCUs / LED array (those stay dark/silent with it on
			 * -> board-level enable/level still unresolved). Harmless if on. */
			reg_boost: boost {
				regulator-name = "boost-5v";
				regulator-min-microvolt = <4550000>;
				regulator-max-microvolt = <5510000>;
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};

	/*
	 * External "big" cluster CPU supply = AXP1530 buck PMIC @ 0x36 (vendor
	 * cpu-supply for cluster1 / cpu4-7). CONFIRMED ON HARDWARE 2026-07-22
	 * (docs/ON-DEVICE-FINDINGS.md): the r_i2c0 (i2c-6) scan shows 0x34 (axp717)
	 * and 0x36 (axp1530) driver-bound; 0x41 is ABSENT. The board has three
	 * CPU-buck footprints (tcs@41 / sy@60 / axp1530@36) and only axp1530 is
	 * populated — so our earlier tcs4838 (patch 0014) was the wrong chip.
	 * axp1530 is already mainline (x-powers,axp1530 in axp20x). dcdc1 = the
	 * big-core rail; dcdc2/dcdc3 are live vendor rails kept always-on. Voltages
	 * capped by the big-cluster OPP ladder (dts/staging/trimui-cpu-opp.dtsi).
	 */
	axp1530: pmic@36 {
		compatible = "x-powers,axp1530";
		reg = <0x36>;

		regulators {
			reg_ext_dcdc1: dcdc1 {
				regulator-name = "vdd-cpu-big";
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <1150000>;	/* nominal ceiling; raise for turbo OPPs */
				regulator-boot-on;
				regulator-always-on;
			};

			reg_ext_dcdc2: dcdc2 {
				regulator-name = "axp1530-dcdc2";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1540000>;
				regulator-always-on;
			};

			reg_ext_dcdc3: dcdc3 {
				regulator-name = "axp1530-dcdc3";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1840000>;
				regulator-always-on;
			};
		};
	};
};

/* microSD */
&mmc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc0_pins>;
	bus-width = <4>;
	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>;	/* PF6 */
	vmmc-supply = <&reg_cldo3>;	/* VERIFY */
	vqmmc-supply = <&reg_cldo1>;	/* VERIFY */
	cap-sd-highspeed;
	status = "okay";
};

/* WiFi over SDIO (vendor wlan_busnum = 1). Chip unidentified -> no child yet. */
&mmc1 {
	/* Force SDIO default speed: the SoC dtsi advertises cap-sd-highspeed, but
	 * the A523 sunxi-mmc HS read sample-phase is uncalibrated (RD DCE). Delete
	 * it so the bus stays at 25 MHz default speed (reads cleanly). See below. */
	/delete-property/ cap-sd-highspeed;
	pinctrl-names = "default";
	pinctrl-0 = <&mmc1_pins>;
	bus-width = <4>;
	non-removable;
	vmmc-supply = <&reg_aldo3>;	/* 3.3V (vendor) */
	vqmmc-supply = <&reg_aldo3>;	/* 3.3V: AIC8800 SDIO signals at 3.3V */
	no-1-8-v;			/* lock 3.3V signalling (no 1.8V UHS switch) */
	mmc-pwrseq = <&wifi_pwrseq>;
	keep-power-in-suspend;
	/* AIC8800 SDIO: match vendor sdc1 — SDIO-only + SDIO IRQ. */
	no-mmc;
	no-sd;
	cap-sdio-irq;
	/*
	 * WORKAROUND: SDIO at 25 MHz default speed. The A523 sunxi-mmc read
	 * sample-phase is uncalibrated for high speed, so UHS/HS data reads
	 * CRC-fail (RD DCE); default speed reads cleanly. TODO: port the A523
	 * mmc sample-delay to restore SDR50/104 (up to 208 MHz).
	 */
	max-frequency = <25000000>;
	/*
	 * Chip = AIC8800 (firmware-confirmed), driven by the out-of-tree aic8800
	 * SDIO module which probes the function automatically, so no wifi@1 child
	 * with a mainline compatible. Vendor control lines on R_PIO Port M:
	 * wlan_hostwake = PM0, chip_en = PM5 (wlan_regon = PM1 -> wifi_pwrseq).
	 */
	status = "okay";
};

/* eMMC */
&mmc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc2_pins>;
	bus-width = <8>;
	non-removable;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	vmmc-supply = <&reg_cldo3>;	/* 3.3V VERIFY */
	vqmmc-supply = <&reg_cldo1>;	/* 1.8V VERIFY */
	status = "okay";
};

/*
 * CPU idle states (PSCI) — WFI cpu-sleep + cluster power-down, for battery life.
 * Latencies/residencies transcribed from the vendor DTB; VERIFY on hardware.
 */
/ {
	cpus {
		idle-states {
			entry-method = "psci";

			cpu_sleep: cpu-sleep {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010000>;
				local-timer-stop;
				entry-latency-us = <46>;
				exit-latency-us = <59>;
				min-residency-us = <3570>;
			};

			cluster_sleep: cluster-sleep {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010000>;
				local-timer-stop;
				entry-latency-us = <47>;
				exit-latency-us = <74>;
				min-residency-us = <5000>;
			};
		};
	};
};

&cpu0 { cpu-idle-states = <&cpu_sleep &cluster_sleep>; };
&cpu1 { cpu-idle-states = <&cpu_sleep &cluster_sleep>; };
&cpu2 { cpu-idle-states = <&cpu_sleep &cluster_sleep>; };
&cpu3 { cpu-idle-states = <&cpu_sleep &cluster_sleep>; };
&cpu4 { cpu-idle-states = <&cpu_sleep &cluster_sleep>; };
&cpu5 { cpu-idle-states = <&cpu_sleep &cluster_sleep>; };
&cpu6 { cpu-idle-states = <&cpu_sleep &cluster_sleep>; };
&cpu7 { cpu-idle-states = <&cpu_sleep &cluster_sleep>; };

/* USB */
&usb_otg {
	/*
	 * The external "usb/dp" USB-C is the DATA/host port (charging + DP-altmode
	 * video are on the SECOND USB-C). Force HOST: the port always enumerates
	 * USB devices (keyboard/mouse/storage/hub) and never acts as a gadget.
	 * (Was dr_mode="otg" + usb-role-switch, but the husb311 Type-C PD fails to
	 * probe on HW so the role-switch never fired -> host was stuck/flaky.
	 * Forcing host removes that dependency; husb311 is kept for future PD/DP.)
	 */
	dr_mode = "host";
	status = "okay";

	port {
		usb_otg_hs_ep: endpoint {
			remote-endpoint = <&usbc_hs_ep>;
		};
	};
};

&usbphy {
	/*
	 * Source VBUS for host mode from the always-on AXP2202 5V boost (the board
	 * routes it to the OTG VBUS; mainline has no AXP717 drivevbus regulator).
	 * Without a real supply the phy logs "dummy supplies not allowed for
	 * exclusive requests (id=vbus)" and host VBUS is marginal.
	 */
	usb0_vbus-supply = <&reg_boost>;
	/* Host port 1 ("USB host" USB-C) VBUS switch on PE6 (HW-verified). */
	usb1_vbus-supply = <&reg_usb1_vbus>;
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ohci0 {
	status = "okay";
};

/* Internal host bus - one port carries the gamepad MCU (buttons over USB). */
&ehci1 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

/*
 * USB-C Type-C port controller on the "usb/dp" port. husb311 (Hynetek) is
 * register-compatible with the Richtek RT1711H. It negotiates USB-PD (charging)
 * and drives the OTG data-role switch (usb-role-switch on &usb_otg, via the
 * sunxi musb role-switch support) so the port can host adapters as well as
 * charge / act as a gadget. VERIFY on hardware: bus/pins (i2c5 = PB11/PB12),
 * ALERT irq (PL13), the PDOs, and a vbus-supply (an AXP drive-vbus rail) if
 * bus-powered host peripherals (keyboard/mouse) are to be powered.
 */
&i2c5 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pb_pins>;
	status = "okay";

	usb_pd: usb-pd@4e {
		compatible = "hynetek,husb311", "richtek,rt1711h";
		reg = <0x4e>;
		interrupt-parent = <&r_pio>;
		interrupts = <0 13 IRQ_TYPE_LEVEL_LOW>;	/* PL13, active-low ALERT */
		wakeup-source;

		connector {
			compatible = "usb-c-connector";
			label = "usb/dp";
			power-role = "dual";
			data-role = "dual";
			try-power-role = "source";
			op-sink-microwatt = <1000000>;
			/* PDOs transcribed from the vendor DTB — VERIFY on hardware. */
			sink-pdos = <0x220190c8 0x864190c8>;
			source-pdos = <0x22019032 0x86419078>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					usbc_hs_ep: endpoint {
						remote-endpoint = <&usb_otg_hs_ep>;
					};
				};
			};
		};
	};
};

&pio {
	/* A523 pin I/O withstand: feed the mmc bank supplies so the pinctrl sets
	 * 1.8V mode on PortC (eMMC) + PortG (WiFi SDIO). Pairs with the A523
	 * CTL_INV withstand fix (kernel patch 0032). Cubie-A5E pattern. */
	vcc-pc-supply = <&reg_cldo1>;	/* eMMC mmc2 I/O 1.8V */
	vcc-pg-supply = <&reg_aldo3>;	/* WiFi PortG I/O 3.3V (AIC8800 3.3V SDIO) */
	i2c5_pb_pins: i2c5-pb-pins {
		pins = "PB11", "PB12";	/* TWI5-SCK / TWI5-SDA */
		allwinner,pinmux = <2>;
		function = "i2c5";
	};

	/* Gamepad MCU serial links, RX-only single-wire (one pin each). */
	uart5_pk17_pin: uart5-pk17-pin {
		pins = "PK17";
		function = "uart5";	/* PK17 Function4 = UART5-RX */
		allwinner,pinmux = <4>;
	};

	uart7_pk13_pin: uart7-pk13-pin {
		pins = "PK13";
		function = "uart7";	/* PK13 Function3 = UART7-RX */
		allwinner,pinmux = <3>;
	};
};

/*
 * Mali-G57 (Valhall, Job-Manager) — Panfrost. Node, binding and driver are all
 * upstream; the board only enables it and supplies the rail. mali-supply =
 * AXP2202 dcdc2 (resolved from the vendor DTB; a shared GPU+VE rail). See
 * docs/GPU-NOTES.md.
 */
&gpu {
	mali-supply = <&reg_dcdc2>;
	status = "okay";
};

/*
 * Internal audio codec (driver sun55i-codec; node in sun55i-a523.dtsi). avcc =
 * analog 1.8 V = AXP2202 aldo4 (vendor avcc-supply). Speaker amp enable = PH6
 * (active high). The routing mirrors the vendor card: DAC -> line-out/HP pins,
 * speaker fed from the line-out pins, mics -> ADCs. Jack/HMIC detect is WIP
 * (see docs/AUDIO-CODEC-NOTES.md).
 */
&codec {
	/*
	 * Card wired for Chen-Yu Tsai's upstream sun4i-codec A523 variant, which
	 * parses the card from the GENERIC "widgets"/"audio-routing" on this node
	 * (not the old allwinner,* names our previous standalone driver used).
	 * Speaker is driven from LINEOUT, headphone from HP, mic on MIC1 (matches
	 * the vendor topology). avcc = analog 1.8 V (AXP2202 aldo4).
	 */
	widgets = "Speaker", "Speaker",
		  "Headphone", "Headphone",
		  "Microphone", "Mic";
	audio-routing = "Speaker", "LINEOUT",
			"Headphone", "HP",
			"MIC1", "Mic";
	avcc-supply = <&reg_aldo4>;
	status = "okay";
};

/*
 * Speaker power-amp enable = PH6 (active high). Chen-Yu's codec card has no
 * pa-gpios / aux-amplifier support yet, and a gpio-hog child under &pio fails
 * (this A523 pinctrl parses every &pio child as a pinmux group -> -22, killing
 * gpiochip0), so the enable is driven via the always-on reg_spk_amp fixed-reg
 * (see the / node). TODO (feedback to the codec author): add pa-gpios (or a
 * simple-audio-amplifier aux-dev) so this becomes a DAPM-gated, power-aware
 * enable instead of an always-on regulator.
 * NB: PH6 is driven, but analog output is still silent (separate codec-driver
 * gap) — see docs/AUDIO-CODEC-NOTES.md.
 */

/*
 * Side keys on LRADC (vendor "keyboard_1350mv", 3 keys). The per-key voltages
 * and keycodes are transcribed from the vendor DTB (key0/1/2 = <voltage_mV
 * keycode>): 410 mV / KEY_HOMEPAGE, 646 mV / KEY_VOLUMEUP, 900 mV /
 * KEY_VOLUMEDOWN. So these are the vendor's measured thresholds, not guesses —
 * confirm on HW with evtest. If a key doesn't fire, mainline's r329-LRADC scale
 * differs from the vendor 1350 mV reference: read the driver's measured voltage
 * (temporary dev_info in sun4i-lradc-keys.c) and/or fix vref-supply. See the
 * "LRADC keys" step in docs/HARDWARE-BRINGUP.md.
 */
&lradc {
	vref-supply = <&reg_bldo2>;	/* 1.8V VERIFY (LRADC reference rail) */
	status = "okay";

	button-410 {
		label = "Home";
		linux,code = <KEY_HOMEPAGE>;
		channel = <0>;
		voltage = <410000>;	/* vendor key0; confirm on HW */
	};

	button-646 {
		label = "Volume Up";
		linux,code = <KEY_VOLUMEUP>;
		channel = <0>;
		voltage = <646000>;	/* vendor key1; confirm on HW */
	};

	button-900 {
		label = "Volume Down";
		linux,code = <KEY_VOLUMEDOWN>;
		channel = <0>;
		voltage = <900000>;	/* vendor key2; confirm on HW */
	};
};

/*
 * NO analog sticks on the GPADC. CONFIRMED ON HARDWARE 2026-07-22
 * (docs/ON-DEVICE-FINDINGS.md): the whole gamepad — buttons, D-pad, both sticks
 * (ABS_X/Y/RX/RY) and analog L2/R2 (ABS_Z/RZ) — comes from two serial MCUs on
 * uart5/uart7, read by the `trimui_inputd` daemon and exposed as the `js0`
 * "TRIMUI Player1" uinput device. `trimui_inputd` holds no GPADC fd. So the
 * earlier adc-joystick + 2nd-GPADC (patch 0012) approach was wrong and is
 * dropped; the SoC GPADC (adc@2009000) is left in its upstream default (its
 * on-board use, if any, is unconfirmed). The gamepad path is uart5 + uart7
 * (enabled below) + the daemon/serdev; see the gamepad section.
 */

&rtc {
	status = "okay";
};

/*
 * Addressable RGB LED array (17 LEDs, WS2812-style) on the LEDC controller,
 * data on PH19. The LEDC node + driver landed in mainline v7.1
 * (allwinner,sun55i-a523-ledc -> sun50i-a100-ledc). Vendor DTB: led_count=17,
 * output_mode="RGB". pixel-format defaults to grb (WS2812); flip on HW if colours
 * are swapped. VERIFY count/order against the device.
 */
&ledc {
	pinctrl-names = "default";
	pinctrl-0 = <&ledc_ph_pin>;
	status = "okay";

	multi-led@0 {
		reg = <0x0>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <0>;
	};
	multi-led@1 {
		reg = <0x1>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <1>;
	};
	multi-led@2 {
		reg = <0x2>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <2>;
	};
	multi-led@3 {
		reg = <0x3>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <3>;
	};
	multi-led@4 {
		reg = <0x4>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <4>;
	};
	multi-led@5 {
		reg = <0x5>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <5>;
	};
	multi-led@6 {
		reg = <0x6>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <6>;
	};
	multi-led@7 {
		reg = <0x7>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <7>;
	};
	multi-led@8 {
		reg = <0x8>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <8>;
	};
	multi-led@9 {
		reg = <0x9>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <9>;
	};
	multi-led@a {
		reg = <0xa>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <10>;
	};
	multi-led@b {
		reg = <0xb>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <11>;
	};
	multi-led@c {
		reg = <0xc>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <12>;
	};
	multi-led@d {
		reg = <0xd>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <13>;
	};
	multi-led@e {
		reg = <0xe>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <14>;
	};
	multi-led@f {
		reg = <0xf>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <15>;
	};
	multi-led@10 {
		reg = <0x10>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_INDICATOR;
		function-enumerator = <16>;
	};
};

#include "trimui-de-reconcile.dtsi"
#include "trimui-panel.dtsi"
#include "trimui-thermal.dtsi"

